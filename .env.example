# Docker Compose deployment
COMPOSE_PROJECT_NAME=ai-zero-token
IMAGE_NAME=ai-zero-token:local
CONTAINER_NAME=ai-zero-token
HOST_PORT=80

# Keep the app runtime home at /data in the container.
# The host bind mount below persists SQLite, generated images, uploads, and local state.
AI_ZERO_TOKEN_STATE_DIR=./state

# PostgreSQL and Redis local bind mounts.
POSTGRES_DATA_DIR=./state/postgres
REDIS_DATA_DIR=./state/redis

# PostgreSQL service. Change the password before production use.
POSTGRES_DB=ai_zero_token
POSTGRES_USER=azt
POSTGRES_PASSWORD=change-me-please
AZT_DATABASE_URL=postgresql://azt:change-me-please@postgres:5432/ai_zero_token
AZT_DB_POOL_MAX=20
DATABASE_URL=postgresql://azt:change-me-please@postgres:5432/ai_zero_token
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=15432

# Redis service is internal-only by default.
REDIS_URL=redis://redis:6379/0
AZT_REDIS_URL=redis://redis:6379/0
AZT_REDIS_KEY_PREFIX=azt
AZT_REDIS_COMMAND_TIMEOUT_MS=5000
AZT_REDIS_THROTTLE_SLOT_TTL_MS=600000
AZT_REDIS_THROTTLE_POLL_MS=250
REDIS_BIND_HOST=127.0.0.1
REDIS_HOST_PORT=16379

# App security. Change all secrets before exposing the service.
AZT_ADMIN_USER=admin
AZT_ADMIN_PASSWORD=change-me-admin-password
AZT_API_KEY=change-me-api-key
AZT_SESSION_SECRET=change-me-session-secret-at-least-32-chars

# Gateway runtime knobs.
AZT_CORS_ORIGIN=*
AZT_BODY_LIMIT_MB=128
AZT_ACCOUNT_MAX_CONCURRENCY=4
AZT_CODEX_REQUEST_SERIALIZATION_ENABLED=1
AZT_CODEX_REQUEST_MIN_DELAY_MS=0
AZT_CODEX_REQUEST_JITTER_MS=0

# Verification script defaults.
AZT_PERF_BASE_URL=http://127.0.0.1
AZT_PERF_USERNAME=admin
AZT_PERF_PASSWORD=change-me-admin-password
AZT_PERF_THRESHOLD_MS=2000
AZT_PERF_TIMEOUT_MS=8000
AZT_PERF_CONCURRENCY=200
AZT_PERF_REQUESTS=200
